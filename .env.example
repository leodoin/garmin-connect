# Public HTTPS origin, without /mcp
MCP_BASE_URL=https://your-server.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this verified Google account can read your Garmin data
ALLOWED_GOOGLE_EMAIL=
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_SIGNING_KEY=
GARMIN_TOKEN_DIR=.data/garmin
# Defaults to loopback; use 0.0.0.0 only inside a secured hosting environment
MCP_HOST=127.0.0.1
MCP_PORT=8000
